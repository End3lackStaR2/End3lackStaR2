{
  "manifest_version": 3,
  "name": "Friday bridge",
  "version": "1.0.0",
  "description": "Lets a local script ask questions through the Arena tab you choose. Nothing runs until you press Attach.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Friday bridge"
  }
}
